# Backend configuration only. Copy to backend/.env or the location chosen by the app.
# Never put real secrets in this example file or commit a real .env file.

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional, if selected during implementation:
# MODEL_NAME=
# FRONTEND_ORIGIN=http://localhost:5173
# API_BASE_URL=http://localhost:8000

# Authentication (Milestone 8 - Task 8.2)
# AUTH_SECRET_KEY=replace_with_a_secure_random_key_at_least_32_characters_long
# AUTH_TOKEN_EXPIRE_MINUTES=60
# AUTH_ALGORITHM=HS256

# Storage Provider Configuration (Milestone 11)
# Default is 'local' (files persisted to local disk under data/uploads/)
# STORAGE_PROVIDER=local
# UPLOADS_DIR=data/uploads
# MAX_UPLOAD_BYTES=31457280

# Database Configuration (Neon PostgreSQL / Phase 7)
# When DATABASE_URL is unset, the system defaults to zero-cost file-backed snapshot mode.
# 1. Runtime API database connection (FastAPI Web Service - uses pooled endpoint port 6543):
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# 2. Direct unpooled migration connection (Alembic DDL runner - direct endpoint port 5432):
# DIRECT_DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# 3. Dedicated worker database connection (Ingestion Daemon - restricted sebi_worker login):
# WORKER_DATABASE_URL=postgresql://sebi_worker:worker_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Connection pool settings:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30.0
# DB_POOL_RECYCLE=300

# Cloudflare R2 / S3-Compatible Durable Storage
# To enable, set STORAGE_PROVIDER=s3 and supply valid credentials:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=<your-private-bucket-name>
# S3_ACCESS_KEY_ID=<your-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-secret-access-key>
# S3_REGION_NAME=auto
