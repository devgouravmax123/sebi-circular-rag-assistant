# Standalone Minimal Demo Container for Render Free (512MB RAM target)
# Lexical-only BM25 mode; No PyTorch, SentenceTransformers, or PostgreSQL required.
FROM python:3.12-slim

WORKDIR /app

# Install minimal system dependencies (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install slim Python dependencies
COPY backend/requirements-demo.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-demo.txt

# Create non-root application user
RUN groupadd -g 10001 citenza && \
    useradd -u 10001 -g citenza -m -s /bin/bash citenza

# Create data directories with permissions
RUN mkdir -p /app/data/processed /app/data/indexes /app/data/uploads && \
    chown -R citenza:citenza /app/data

# Copy application source code
COPY --chown=citenza:citenza backend/app /app/app

# Copy immutable snapshot assets and verified graph
COPY --chown=citenza:citenza data/manifests /app/data/manifests
COPY --chown=citenza:citenza data/indexes /app/data/indexes
COPY --chown=citenza:citenza data/processed/manifest.json /app/data/processed/manifest.json

# Configure runtime environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PROCESSED_DIR=/app/data/processed \
    INDEXES_DIR=/app/data/indexes \
    RETRIEVAL_MODE=lexical_only \
    APP_ENV=production \
    SYNTHESIS_PROVIDER=mock \
    PORT=8000

USER citenza

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
