# ---------------------------------------------------------------------------
# SEBI Regulatory Intelligence Platform - Production Environment Template
# ---------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env.prod' for local containerized deployment.
# 2. Populate placeholders with secure, non-default credentials.
# 3. NEVER commit real secret keys, database passwords, or .env.prod to Git.
# ---------------------------------------------------------------------------

# Runtime Environment
APP_ENV=production

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password_min_16_chars
POSTGRES_DB=sebi_rag_prod
POSTGRES_PORT=5432

# Backend Connection String (Internal Docker Network)
DATABASE_URL=postgresql+psycopg://postgres:replace_with_strong_database_password_min_16_chars@postgres:5432/sebi_rag_prod

# Database Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=300

# Administrative API Authentication (Min 16 chars required in production)
ADMIN_API_KEY=replace_with_secure_random_admin_api_key_min_16_chars

# Frontend and CORS Origins (Comma-separated list, NO wildcard '*' in production)
FRONTEND_ORIGIN=http://localhost:80,http://localhost:5173,http://127.0.0.1:80
VITE_API_BASE_URL=http://localhost:8000

# Synthesis Provider Mode (Strictly offline mock provider by default)
SYNTHESIS_PROVIDER=mock
SYNTHESIS_TIMEOUT_SECONDS=5.0
MAX_SYNTHESIS_EVIDENCE_CHUNKS=5

# Directory Paths inside container
PROCESSED_DIR=/app/data/processed
INDEXES_DIR=/app/data/indexes
